.venv/
__pycache__/
*.pyc
sandbox_data/
.pytest_cache/
.streamlit/secrets.toml
.scratch/

# Anything pulled out of the live database. Holds member names against payment
# amounts -- never commit it, however convenient it would be.
supabase-export/
supabase-backup*/
prod_export/
*.dump

# --- Secrets ------------------------------------------------------------------
# Broadened after a service_role key reached a public repo through
# .streamlit/secrets.toml. The old rule matched one exact path, so a file named
# secrets.local.toml, a stray .env, or a secrets file in any other directory
# would still have been committable. tests/test_no_secrets.py enforces this
# independently, because a .gitignore only helps for files nobody force-adds.
secrets.toml
*secrets.toml
.streamlit/secrets*.toml
.env
.env.*
!.env.example
*.key
*.pem

# Per-person Claude Code settings (local permissions, file paths).
.claude/settings.local.json

# Private exports (financial history, member databases). They hold names against
# payment amounts. Keep them OUT of this folder; these rules are the safety net
# for the day one lands here by accident.
*.xlsx
*.xls
*.xlsm
*private_test*
