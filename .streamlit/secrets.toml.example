# Template. Copy to `.streamlit/secrets.toml` and fill in — that filename is
# gitignored, this one is not. NEVER put a real value in this file.
#
# Production only. The sandbox needs none of this and refuses to contact any
# external service regardless of what is set here.

# --- Supabase -----------------------------------------------------------------
# Use the NEW key format (Settings -> API Keys -> "Publishable and secret API
# keys"), not the legacy anon/service_role JWTs:
#
#   secret       sb_secret_...        bypasses RLS — server-side only, never ship
#                                     it anywhere a user can read
#
# The app needs only the secret key. Migration 008_lock_down.sql leaves the
# publishable key able to read nothing, so the app no longer uses it.
#
# The legacy keys cannot be rotated any more, only deactivated. If one leaks,
# deactivating it in the dashboard is the only thing that actually revokes it —
# creating replacement keys does not.

[supabase]
url = "https://<project-ref>.supabase.co"
secret_key = "sb_secret_REPLACE_ME"

# --- Treasury operator password -----------------------------------------------
# The shared password for the fallback login. Long and random; it grants ADMIN.

[treasury]
password = "REPLACE_ME"
operator_email = "treasurer@example.org"

# --- Google sign-in (optional) -------------------------------------------------
# Only needed for the VP portal. Absent = password-only login, no behaviour
# change anywhere else.

# [auth]
# client_id = "REPLACE_ME.apps.googleusercontent.com"
# client_secret = "REPLACE_ME"
# server_metadata_url = "https://accounts.google.com/.well-known/openid-configuration"
# redirect_uri = "https://<your-deployed-url>/oauth2callback"
# cookie_secret = "REPLACE_ME_random_32_bytes"
